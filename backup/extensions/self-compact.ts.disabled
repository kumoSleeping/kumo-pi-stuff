import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";

const SYSTEM_PROMPT_SECTION = `
## Context Self-Management

self-compress: use compact_context to compress conversation history into a summary, freeing context space.

- After exploring (reading files, research) and before making changes — keep plan and findings, drop raw output.
- After pulling in noisy material (search results, docs, logs, large dumps) — keep conclusions, drop the noise.
- After a phase is done and verified, before starting the next.
- Not when the task is finished, you're waiting on the user, context is short, or you just compacted.
- Pass \`focus\`: goal, plan, decisions, file paths, key data. Then end your turn; resume immediately when told.
`.trim();

const TOOL_DESCRIPTION = [
	"self-compress conversation history into a summary to free context space.",
	"Call after exploring and before changes, after noisy material, or after a verified milestone.",
	"Not when done, waiting on the user, context is short, or just compacted.",
	"Pass `focus` (goal, plan, decisions, paths, key data), then end your turn.",
].join(" ");

const RESUME_MESSAGE = "[self-compact] Context compaction complete.";

const RESUME_AFTER_FAILURE_MESSAGE =
	"[self-compact] Context compaction failed (see the error notification). " +
	"Your context was NOT compacted, but do not stall: continue your task " +
	"with the existing context. You may call compact_context again later if " +
	"the context grows noisy, but do not retry immediately.";

function isAbortError(error: Error): boolean {
	return error.name === "AbortError" || /abort/i.test(error.message);
}

export default function (pi: ExtensionAPI) {
	// True while a model-requested compaction is scheduled/running.
	// Prevents double-scheduling (and therefore double resume messages)
	// if the model calls the tool again before the first one completes.
	let pending = false;
	// Inject usage guidelines into the system prompt every turn.
	pi.on("before_agent_start", async (event) => {
		return {
			systemPrompt: event.systemPrompt + "\n\n" + SYSTEM_PROMPT_SECTION,
		};
	});

	// Wrap pi's compaction API as a model-callable tool.
	pi.registerTool({
		name: "compact_context",
		label: "Compact Context",
		description: TOOL_DESCRIPTION,
		parameters: Type.Object({
			focus: Type.Optional(
				Type.String({
					description:
						"What the summary must preserve: current goal, plan for upcoming steps, key decisions, file paths, critical data.",
				}),
			),
		}),
		async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
			if (pending) {
				return {
					content: [
						{
							type: "text",
							text:
								"A compaction you requested is already scheduled or running. " +
								"Do not call compact_context again — end your turn and wait " +
								"for the resume message.",
						},
					],
					details: { scheduled: false, reason: "already_pending" },
					isError: true,
				};
			}

			pending = true;
			ctx.compact({
				customInstructions: params.focus,
				onComplete: () => {
					pending = false;
					if (ctx.hasUI) {
						ctx.ui.notify("Self-compaction completed", "info");
					}
					// Wake the model up so the task continues after compaction
					// instead of stalling until the user types something.
					if (ctx.isIdle()) {
						pi.sendUserMessage(RESUME_MESSAGE);
					} else {
						pi.sendUserMessage(RESUME_MESSAGE, { deliverAs: "followUp" });
					}
				},
				onError: (error) => {
					pending = false;
					if (ctx.hasUI) {
						ctx.ui.notify(`Self-compaction failed: ${error.message}`, "error");
					}
					// Do not auto-resume if the failure was a user abort (Esc) —
					// the user explicitly interrupted; respect that.
					if (isAbortError(error)) {
						return;
					}
					// Otherwise wake the model up: compaction failed but the task
					// should continue with the existing (uncompacted) context.
					if (ctx.isIdle()) {
						pi.sendUserMessage(RESUME_AFTER_FAILURE_MESSAGE);
					} else {
						pi.sendUserMessage(RESUME_AFTER_FAILURE_MESSAGE, { deliverAs: "followUp" });
					}
				},
			});

			return {
				content: [
					{
						type: "text",
						text:
							"Compaction scheduled. The conversation history will be compressed " +
							"into a structured summary between turns, preserving the focus you " +
							"provided. End your turn now — do not start new work until the " +
							"compacted context is in place. When compaction completes, you will " +
							"receive a message telling you to resume; continue the task then.",
					},
				],
				details: { scheduled: true, focus: params.focus ?? null },
			};
		},
	});
}
