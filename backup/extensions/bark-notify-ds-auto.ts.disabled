import { uuidv7 } from "@earendil-works/pi-ai";
import { complete } from "@earendil-works/pi-ai/compat";
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const DEFAULT_BARK_URL = "https://api.day.app/m6P3MRAmkUw5qUDVBez5y6";
const PROVIDER = "deepseek";
const MODEL_ID = "deepseek-v4-flash";
const MAX_SOURCE_CHARS = 40_000;

function describeError(error: unknown): string {
	if (!(error instanceof Error)) return String(error);
	// Node fetch failures surface as TypeError("fetch failed") with the real
	// reason (ECONNRESET, UND_ERR_SOCKET, ...) in the cause chain.
	const parts = [error.message];
	let cause: unknown = (error as { cause?: unknown }).cause;
	while (cause) {
		if (cause instanceof Error) {
			const code = (cause as { code?: string }).code;
			parts.push(code ? `${code}: ${cause.message}` : cause.message);
			cause = (cause as { cause?: unknown }).cause;
		} else {
			parts.push(String(cause));
			break;
		}
	}
	return parts.join(" <- ");
}

async function sendBarkNotification(title: string, body: string): Promise<void> {
	const barkUrl = process.env.BARK_NOTIFY_URL?.trim().replace(/\/+$/, "") || DEFAULT_BARK_URL;
	const url = `${barkUrl}/${encodeURIComponent(title)}/${encodeURIComponent(body)}`;
	let lastError: unknown;
	for (let attempt = 1; attempt <= 3; attempt++) {
		try {
			const response = await fetch(url);
			if (!response.ok) throw new Error(`Bark HTTP ${response.status}`);
			return;
		} catch (error) {
			lastError = error;
			if (attempt < 3) {
				await new Promise((resolve) => setTimeout(resolve, 1000 * attempt));
			}
		}
	}
	throw lastError;
}

function textFromAssistant(message: unknown): string {
	if (!message || typeof message !== "object" || (message as { role?: string }).role !== "assistant") return "";
	const content = (message as { content?: unknown }).content;
	if (!Array.isArray(content)) return "";
	return content
		.filter((block): block is { type: "text"; text: string } =>
			Boolean(block && typeof block === "object" && (block as { type?: string }).type === "text" && typeof (block as { text?: unknown }).text === "string"),
		)
		.map((block) => block.text)
		.join("\n")
		.trim();
}

function parseSummary(raw: string): { title: string; body: string } {
	const cleaned = raw.trim().replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/, "");
	const parsed = JSON.parse(cleaned) as { title?: unknown; body?: unknown };
	if (typeof parsed.title !== "string" || !parsed.title.trim() || typeof parsed.body !== "string" || !parsed.body.trim()) {
		throw new Error("DeepSeek 返回的标题或正文为空");
	}
	return { title: parsed.title.trim(), body: parsed.body.trim() };
}

export default function barkNotifyDeepSeekAuto(pi: ExtensionAPI) {
	let finalAssistantText = "";
	let notifying = false;

	pi.on("agent_start", () => {
		finalAssistantText = "";
	});

	// turn_end may happen many times because of tool calls. Keep only the latest assistant
	// text, then wait for agent_settled so retries, compaction and follow-ups are all finished.
	pi.on("turn_end", (event) => {
		const text = textFromAssistant(event.message);
		if (text) finalAssistantText = text;
	});

	pi.on("agent_settled", async (_event, ctx) => {
		const source = finalAssistantText;
		finalAssistantText = "";
		if (!source || notifying) return;
		notifying = true;

		try {
			const model = ctx.modelRegistry.find(PROVIDER, MODEL_ID);
			if (!model) throw new Error(`找不到模型 ${PROVIDER}/${MODEL_ID}`);

			const auth = await ctx.modelRegistry.getApiKeyAndHeaders(model);
			if (!auth.ok) throw new Error(`DeepSeek 鉴权失败: ${auth.error}`);
			if (!auth.apiKey) throw new Error(`没有 ${PROVIDER} API Key`);

		const clipped = source.length > MAX_SOURCE_CHARS
			? `${source.slice(0, MAX_SOURCE_CHARS)}\n\n[原回复过长，已截断]`
			: source;
		let summary: { title: string; body: string };
		try {
			const response = await complete(
				model,
				{
					messages: [{
						role: "user",
						content: [{
							type: "text",
							text: `请把下面这段模型最终回复总结成 Bark 通知。只输出严格 JSON，不要 Markdown，不要额外文字：\n{"title":"简洁标题","body":"一段简洁但包含关键结果、错误或下一步的正文"}\n\n<final_response>\n${clipped}\n</final_response>`,
						}],
						timestamp: Date.now(),
					}],
				},
				{
					apiKey: auth.apiKey,
					headers: auth.headers,
					env: auth.env,
					maxTokens: 512,
					cacheRetention: "none",
					sessionId: uuidv7(),
				},
			);
			const raw = response.content
				.filter((block): block is { type: "text"; text: string } => block.type === "text")
				.map((block) => block.text)
				.join("\n");
			summary = parseSummary(raw);
		} catch (error) {
			throw new Error(`DeepSeek 总结阶段失败: ${describeError(error)}`);
		}
		try {
			const sessionId = ctx.sessionManager.getSessionId();
			await sendBarkNotification(summary.title, `${summary.body}\n\n会话编号：${sessionId}`);
		} catch (error) {
			throw new Error(`Bark 推送阶段失败: ${describeError(error)}`);
		}
	} catch (error) {
		const message = describeError(error);
		console.error(`[bark-notify-ds-auto] ${message}`);
		if (ctx.hasUI) ctx.ui.notify(`自动 Bark 推送失败: ${message}`, "error");
	} finally {
		notifying = false;
	}
	});
}
